#!/bin/sh
# Block commits that leave a misaligned ASCII diagram in the site content.
#
# Enable:   git config core.hooksPath .githooks
# Disable:  git config --unset core.hooksPath
# Bypass once: git commit --no-verify
#
# The whole corpus is checked rather than just staged files. It takes
# milliseconds, and it means a diagram cannot drift out of alignment in a file
# you did not happen to touch. Mark a deliberate layout with
# `<!-- align: ignore -->` above its fence instead of bypassing the hook.

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 not found, skipping diagram check" >&2
    exit 0
fi

python3 tools/check_diagrams.py || {
    echo >&2
    echo "pre-commit: diagram alignment check failed (see above)." >&2
    echo "  fix the columns, or mark a deliberate layout with" >&2
    echo "  <!-- align: ignore --> on the line above its \`\`\`text fence." >&2
    exit 1
}

python3 tools/check_source_links.py || {
    echo >&2
    echo "pre-commit: source-link check failed (see above)." >&2
    echo "  S1: the section quotes source but links to no file." >&2
    echo "  S2: it links to a file that does not contain the code shown," >&2
    echo "      usually because the link names the type rather than the" >&2
    echo "      file the snippet came from." >&2
    echo "  Mark a deliberately illustrative snippet with" >&2
    echo "  <!-- source-link: ignore --> above its section heading." >&2
    exit 1
}
